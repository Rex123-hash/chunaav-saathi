# =============================================================================
# Chunav Saathi — .gitignore
# =============================================================================

# ── Secrets (NEVER commit these) ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
service-account*.json
*-credentials.json
*-keyfile.json
firebase-adminsdk*.json

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.npm/
.yarn/
yarn.lock
package-lock.json.bak

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed

# ── Build Artifacts ───────────────────────────────────────────────────────────
dist/
build/
.cache/
.parcel-cache/
.next/
out/

# ── Test Coverage ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Google Cloud / Firebase ───────────────────────────────────────────────────
.gcloud/
.firebaserc
firebase.json
firestore-debug.log
ui-debug.log
.firebase/

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.bak
*.orig
*.rej
*~

# ── Temporary Files ───────────────────────────────────────────────────────────
.tmp/
tmp/
temp/

# ── Archives ──────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
