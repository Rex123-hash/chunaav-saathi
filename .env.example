# ==============================================================================
#  Chunav Saathi — Environment Variables
#  Copy this file:  cp .env.example .env
#  Then fill in your real values below.
#
#  ⛔  NEVER commit .env to git — it is in .gitignore.
#  ⛔  NEVER paste real keys into .env.example.
#  ✅  All secrets are read server-side only. The browser never sees them.
# ==============================================================================

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Required. Obtain from: https://aistudio.google.com/app/apikey
# Used exclusively in: src/utils/geminiClient.js (never in /public/)
GEMINI_API_KEY=your-gemini-api-key-here

# ── Google Cloud Project ──────────────────────────────────────────────────────
# Required for Firestore in production.
# Your GCP project ID (e.g. chunav-saathi-prod)
GCLOUD_PROJECT=your-gcp-project-id

# ── Google Cloud Firestore ────────────────────────────────────────────────────
# Optional: Set to use the local Firestore emulator during development.
# Leave commented-out when deploying to Cloud Run / App Engine.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Optional: Path to a service account JSON for local staging (not emulator).
# In Cloud Run, Application Default Credentials are used automatically.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Google Cloud Secret Manager ───────────────────────────────────────────────
# Optional. If using Secret Manager to store GEMINI_API_KEY in production,
# set the full resource name here instead of GEMINI_API_KEY above.
# SECRET_MANAGER_KEY_NAME=projects/your-project/secrets/gemini-api-key/versions/latest

# ── Server Configuration ──────────────────────────────────────────────────────
# Optional. Defaults to 3000 in dev, 8080 in Cloud Run / App Engine.
# PORT=3000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Optional. Comma-separated list of allowed origins for the API.
# If not set, only http://localhost:* is allowed in development.
# CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

# ── Runtime Environment ───────────────────────────────────────────────────────
# Optional. Controls error verbosity: 'production' hides stack traces.
# NODE_ENV=production
